# Read automatically by `vite build` (not by the dev server).
#
# Where the deployed front end sends chat requests. This is a path, not a
# secret — it is meant to be committed, and it is safe to inline into the
# bundle. The dev server ignores this file and uses its own middleware.
#
# For the PHP proxy in deploy/php/. Change it if you host the proxy elsewhere,
# e.g. https://your-worker.workers.dev/chat
VITE_LLM_ENDPOINT=./api/llm/chat.php
