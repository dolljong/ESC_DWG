# Copy this file to `.env.local` and fill in your key. `.env.local` is gitignored
# and is read only by the Vite dev server — nothing here reaches the browser or
# a production build.
#
# This is the site owner's shared key. Visitors who have not connected their own
# OpenRouter account use it, and only free models are ever forwarded, so it
# cannot be billed. Get a key at https://openrouter.ai/keys
#
# Free endpoints usually require opting into prompt logging:
# https://openrouter.ai/settings/privacy
OPENROUTER_API_KEY=

# Optional: point the app at a deployed proxy instead of the dev middleware.
# VITE_LLM_PROXY_URL=https://your-worker.workers.dev/api/llm
